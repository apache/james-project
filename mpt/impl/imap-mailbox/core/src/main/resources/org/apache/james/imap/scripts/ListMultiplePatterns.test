# RFC 5258 multiple mailbox patterns
C: 10 CREATE patterntest
S: 10 OK \[MAILBOXID \(.+\)\] CREATE completed.
C: 11 CREATE patterntest.child
S: 11 OK \[MAILBOXID \(.+\)\] CREATE completed.
C: 12 CREATE other
S: 12 OK \[MAILBOXID \(.+\)\] CREATE completed.

# Two patterns
C: A1 LIST "" ("INBOX" "patterntest.%")
SUB {
S: \* LIST \(\\HasNoChildren\) \"\.\" "INBOX"
S: \* LIST \(\\HasNoChildren\) \"\.\" "patterntest.child"
}
S: A1 OK LIST completed.

# A single pattern list
C: A2 LIST "" (other)
S: \* LIST \(\\HasNoChildren\) \"\.\" "other"
S: A2 OK LIST completed.

# A mailbox matching several patterns is returned once
C: A3 LIST "" ("patterntest" patterntest* "*")
SUB {
S: \* LIST \(\\HasNoChildren\) \"\.\" "INBOX"
S: \* LIST \(\\HasChildren\) \"\.\" "patterntest"
S: \* LIST \(\\HasNoChildren\) \"\.\" "patterntest.child"
S: \* LIST \(\\HasNoChildren\) \"\.\" "other"
}
S: A3 OK LIST completed.

# The empty pattern of a pattern list is ignored
C: A4 LIST "" ("" "other")
S: \* LIST \(\\HasNoChildren\) \"\.\" "other"
S: A4 OK LIST completed.

# Patterns with selection options
C: A5 LIST () "" ("INBOX")
S: \* LIST \(\\HasNoChildren\) \"\.\" "INBOX"
S: A5 OK LIST completed.

# Patterns with return options
C: A6 LIST "" ("patterntest" "patterntest") RETURN (CHILDREN)
S: \* LIST \(\\HasChildren\) \"\.\" "patterntest"
S: A6 OK LIST completed.

C: A7 LIST "" ("other" "oth*") RETURN (STATUS (MESSAGES UNSEEN))
S: \* LIST \(\\HasNoChildren\) \"\.\" "other"
S: \* STATUS \"other\" \(MESSAGES 0 UNSEEN 0\)
S: A7 OK LIST completed.

# Patterns with the SUBSCRIBED selection option
C: A8 SUBSCRIBE patterntest.child
S: A8 OK SUBSCRIBE completed.
C: A9 SUBSCRIBE ghost
S: A9 OK SUBSCRIBE completed.
C: A10 LIST (SUBSCRIBED) "" ("patterntest.child" "patterntest.*" "ghost" "other")
SUB {
S: \* LIST \(\\HasNoChildren \\Subscribed\) \"\.\" "patterntest.child"
S: \* LIST \(\\Subscribed \\NonExistent\) \"\.\" "ghost"
}
S: A10 OK LIST completed.

C: A11 LIST (SUBSCRIBED RECURSIVEMATCH) "" ("patterntest" "%")
SUB {
S: \* LIST \(\\HasChildren\) \"\.\" "patterntest" \(\"CHILDINFO\" \(\"SUBSCRIBED\"\)\)
S: \* LIST \(\\HasNoChildren \\Subscribed\) \"\.\" "INBOX"
S: \* LIST \(\\Subscribed \\NonExistent\) \"\.\" "ghost"
}
S: A11 OK LIST completed.

C: A12 LIST "" ("patterntest*" "*child") RETURN (SUBSCRIBED)
SUB {
S: \* LIST \(\\HasChildren\) \"\.\" "patterntest"
S: \* LIST \(\\HasNoChildren \\Subscribed\) \"\.\" "patterntest.child"
}
S: A12 OK LIST completed.

# Malformed pattern lists
C: A13 LIST "" ()
S: A13 BAD LIST failed. Illegal arguments.
C: A14 LIST "" (INBOX
S: A14 BAD LIST failed. Illegal arguments.

C: A15 UNSUBSCRIBE patterntest.child
S: A15 OK UNSUBSCRIBE completed.
C: A16 UNSUBSCRIBE ghost
S: A16 OK UNSUBSCRIBE completed.
C: A17 DELETE patterntest.child
S: A17 OK DELETE completed.
C: A18 DELETE patterntest
S: A18 OK DELETE completed.
C: A19 DELETE other
S: A19 OK DELETE completed.
