# A negative entry removes the read right granted by a positive one
C: a1 SETACL #user.boby.sharedMailbox -imapuser r
S: a1 OK SETACL completed.

C: a2 MYRIGHTS #user.boby.sharedMailbox
S: \* MYRIGHTS \"#user.boby.sharedMailbox\" \"al\"
S: a2 OK MYRIGHTS completed.

C: a3 STATUS #user.boby.sharedMailbox (MESSAGES)
S: a3 NO STATUS failed. Status failed.

C: a4 LIST "" "#user.boby.sharedMailbox" RETURN (STATUS (MESSAGES SIZE))
S: \* LIST \(\\HasNoChildren\) \".\" \"#user.boby.sharedMailbox\"
S: a4 OK LIST completed.

C: a5 SELECT #user.boby.sharedMailbox
S: a5 NO SELECT failed.
